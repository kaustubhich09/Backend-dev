<!DOCTYPE html>
<html>
<head>
  <title>Photo Gallery</title>
  <style>
    body {
      font-family: Arial;
      text-align: center;
    }
    .gallery {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
    }
    img {
      width: 200px;
      height: 150px;
      margin: 10px;
      border: 2px solid #333;
    }
  </style>
</head>
<body>

  <h1>My Photo Gallery</h1>

  <div class="gallery">
    <% images.forEach(function(image){ %>
      <img src="<%= image %>" />
    <% }) %>
  </div>

</body>
</html>